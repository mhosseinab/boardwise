# OpenAI-compatible LLM endpoint. Point at OpenAI, an Anthropic-compatible
# gateway, or a local function-calling model (Ollama/vLLM). No real secrets
# belong in this file — placeholder values only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-placeholder-do-not-commit-a-real-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Agent tool-calling loop cap.
MAX_TOOL_ITERATIONS=6

# SQLite, file-backed, seeded from sample_data/*.json on startup.
DATABASE_URL=sqlite:///./boardwise.sqlite3
